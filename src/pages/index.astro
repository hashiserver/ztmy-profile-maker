---
import Layout from '../layouts/Layout.astro';
import { templates } from '../data/templates';
---

<Layout
  ><div class="home-shell">
    <section class="tool-intro">
      <p class="index-label">自己紹介カード作成</p>
      <h1>ずとまよ<br />プロフィールメーカー</h1>
      <p>テンプレートを選ぶ → 文字・アイコンを入れる → 画像を保存</p>
    </section>
    <section class="template-section" aria-labelledby="templates-heading">
      <div class="section-title">
        <div>
          <h2 id="templates-heading">テンプレートを選ぶ</h2>
        </div><span class="count"
          >{String(templates.length).padStart(2, '0')} 種類</span
        >
      </div><div class="template-list">
        {
          templates.map((t, index) => (
            <article class="template-tile">
              <>
                <a
                  class="template-art"
                  href={`/edit/${t.id}/`}
                  aria-label={`${t.title}の編集画面を開く`}
                >
                  <>
                    <img
                      src={t.background}
                      alt={
                        t.description ||
                        `${t.title}の自己紹介カード。名前、好きな曲、思い出、ひとこと欄。`
                      }
                      width={t.width}
                      height={t.height}
                    />
                    <span class="tile-badge">{t.badge || 'ORIGINAL DEMO'}</span>
                  </>
                </a>
                <div class="template-info">
                  <>
                    <p class="eyebrow">
                      テンプレート {String(index + 1).padStart(2, '0')}
                    </p>
                    <h3>{t.title}</h3>
                    <p>
                      {t.description ||
                        '横書き・縦書きを試せるオリジナルのデモカードです。'}
                    </p>
                    <a
                      class="author"
                      href={t.author.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <>
                        <img
                          src={t.author.avatar}
                          width="28"
                          height="28"
                          alt=""
                        />
                        <span>{t.author.name} ↗</span>
                      </>
                    </a>
                    <a class="primary-button" href={`/edit/${t.id}/`}>
                      このテンプレートを使う <span aria-hidden="true">→</span>
                    </a>
                  </>
                </div>
              </>
            </article>
          ))
        }
      </div>
    </section>
    <aside class="home-note">
      <span class="note-number">NOTE</span><p>
        現在は開発中のプレビューです。<br />提供テンプレートの作者は @1to_ztmy
        さんです。掲載許諾・利用条件は確認中です。
      </p>
    </aside>
  </div></Layout
>
