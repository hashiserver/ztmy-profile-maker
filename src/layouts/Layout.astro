---
import '../styles/global.css';
const {
  title = 'ztmy profile maker',
  description = 'あなたの「好き」を、一枚に。ブラウザで自己紹介カードを作成する非公式ファンツール。',
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><meta name="description" content={description} /><title>
      {title}
    </title><link
      rel="icon"
      type="image/svg+xml"
      href="/templates/avatar.svg"
    /></head
  ><body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <header class="site-header">
      <a href="/" class="brand"
        ><img src="/templates/avatar.svg" width="28" height="28" alt="" />ztmy <span
          >profile maker</span
        ></a
      ><a href="/about/" class="header-link">このサービスについて ↗</a>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <p>ztmy profile maker <span>非公式ファンツール</span></p><nav
        aria-label="フッター"
      >
        <a href="/about/">このサービスについて</a><a href="/terms/">利用規約</a
        ><a href="/privacy/">プライバシー</a><a
          href="https://github.com/hashiserver/ztmy-profile-maker"
          target="_blank"
          rel="noopener noreferrer">GitHub ↗</a>
      </nav>
    </footer>
  </body>
</html>
