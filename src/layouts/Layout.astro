---
import '../styles/global.css';
const {
  title = 'ずとまよプロフィールメーカー',
  description = 'テンプレートに文字とアイコンを入れて自己紹介カードを作成。ずっと真夜中でいいのに。とは関係のない非公式ファンツールです。',
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><meta name="description" content={description} /><title>
      {title}
    </title><link
      rel="icon"
      type="image/svg+xml"
      href="/templates/avatar.svg"
    /></head
  ><body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <header class="site-header">
      <a href="/" class="brand">ずとまよプロフィールメーカー</a>
      <p class="unofficial-notice">
        非公式ファンサイトです。ずっと真夜中でいいのに。および所属事務所・公式サービスとは関係ありません。
      </p>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <p>ずとまよプロフィールメーカー <span>非公式ファンツール</span></p><nav
        aria-label="フッター"
      >
        <a href="/about/">このサービスについて</a><a href="/terms/">利用規約</a
        ><a href="/privacy/">プライバシー</a><a
          href="https://github.com/hashiserver/ztmy-profile-maker"
          target="_blank"
          rel="noopener noreferrer">GitHub ↗</a
        >
      </nav>
    </footer>
  </body>
</html>
